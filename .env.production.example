# Production settings for SAS. Copy to `.env` ON THE SERVER, fill every <...> value, and never commit the filled file.
# Generate the key on the server: php artisan key:generate

APP_NAME="SAS – Scholarships Application Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain>
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# The database. MySQL 8 / MariaDB 10.6+ (SQLite is for development only).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Extra host names the site answers on, comma-separated (for example the www. name). APP_URL's host is always allowed.
SAS_TRUSTED_HOSTS=

# Use redis for cache and queue where you have it; `database` works on a single small server.
CACHE_STORE=database
QUEUE_CONNECTION=database

# Email that really leaves the server (the System health page warns while this is `log`).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="noreply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"
SAS_MAIL_WEBHOOK_SECRET=

# Uploaded documents and media. Use `s3` (any S3-compatible bucket) when the server disk is not durable.
FILESYSTEM_DISK=local
SAS_MEDIA_DISK_DRIVER=local
SAS_DOCUMENT_DISK_DRIVER=local
SAS_UPLOAD_MAX_KB=20480
SAS_UPLOAD_QUOTA_MB=200
# `clamav` scans every upload and quarantines infected files. It needs clamd on the server; without it uploads wait for manual review.
SAS_SCANNER=clamav

# Who the site says it is. Set SAS_LEGAL_APPROVED=true only after the owner has approved the privacy notice, terms and refund policy.
SAS_LEGAL_ENTITY_NAME="CAS - Consultancy for Abroad Study"
SAS_LEGAL_ENTITY="Operated by CAS - Consultancy for Abroad Study"
SAS_LEGAL_APPROVED=false
SAS_CONTACT_EMAIL=info@<your-domain>
SAS_ENQUIRY_EMAIL=enquiry@<your-domain>
SAS_ADMISSIONS_EMAIL=admissions@<your-domain>
SAS_ACCESSIBILITY_EMAIL=info@<your-domain>
SAS_STAFF_NOTIFICATION_EMAIL=enquiry@<your-domain>
SAS_CONTACT_PHONE="+86 176 4041 2827"
SAS_CONTACT_WHATSAPP="+86 176 4041 2827"
SAS_CONTACT_WECHAT=cas-scholarships

# Staff sign-in with an authenticator app. The owner has chosen OFF for now; turning it on later needs no code change.
SAS_TWO_STEP=false

SAS_AGENT_INVITES_PER_DAY=200

# Live chat (tawk.to) on the public pages only. Empty turns it off.
SAS_TAWK_EMBED=https://embed.tawk.to/6adcff3f803f96347af46f30/1k5nka51i
