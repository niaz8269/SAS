APP_NAME="SAS – Scholarships Application Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated proxy IPs/CIDRs when behind a load balancer (leave empty if not)
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Local/test default is SQLite. Staging and production use MySQL 8.4:
#   DB_CONNECTION=mysql  DB_HOST=...  DB_PORT=3306  DB_DATABASE=sas  DB_USERNAME=...  DB_PASSWORD=...
DB_CONNECTION=sqlite

# --- Sessions, cache, queues ------------------------------------------------
# Production: SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis (+ Horizon)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (local default writes to the log; use a transactional provider in production) ----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Files ---------------------------------------------------------------------
# Public editorial media and PRIVATE student documents are separate disks/buckets.
FILESYSTEM_DISK=local
SAS_MEDIA_DISK_DRIVER=local
SAS_MEDIA_BUCKET=
SAS_MEDIA_URL=
SAS_DOCUMENT_DISK_DRIVER=local
SAS_DOCUMENT_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Upload rules (FILE-01). Quota is a proposal pending owner approval.
SAS_UPLOAD_MAX_KB=20480
SAS_UPLOAD_QUOTA_MB=200
# clamav in staging/production. "fake" exists for tests only and refuses to run in production.
SAS_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Business identity (owner decisions, see docs/DECISIONS.md) ---------------------
SAS_LEGAL_ENTITY="Operating legal entity: to be confirmed"
SAS_CONTACT_EMAIL=hello@example.com
SAS_ACCESSIBILITY_EMAIL=accessibility@example.com
# Address that receives "new enquiry" alerts (optional)
SAS_STAFF_NOTIFICATION_EMAIL=
# Signed delivery webhook (hard bounces / complaints) at POST /webhooks/email/{provider}. Empty disables it.
SAS_MAIL_WEBHOOK_SECRET=


VITE_APP_NAME="${APP_NAME}"
